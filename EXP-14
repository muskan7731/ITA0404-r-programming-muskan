data(ChickWeight)

# Display first records
print(head(ChickWeight))

# Sort according to weight
sorted <- ChickWeight[order(ChickWeight$weight), ]

print(head(sorted))

# Load reshape2
library(reshape2)

# Melt
melted <- melt(
  ChickWeight,
  id.vars = c("Chick", "Time", "Diet")
)

print(head(melted))

# Cast by Diet
casted <- dcast(
  melted,
  Diet ~ variable,
  fun.aggregate = mean
)

print(casted)
