exam_data <- data.frame(
  name = c("John", "Mary", "David", "Lisa", "Peter"),
  score = c(85, 92, 70, 88, 60),
  attempts = c(1, 2, 3, 1, 4),
  qualify = c("Yes", "Yes", "No", "Yes", "No")
)

print(exam_data)

# Extract score column
print(exam_data$score)

# Extract first row
print(exam_data[1, ])

# Add a row
exam_data <- rbind(
  exam_data,
  data.frame(name="Robert", score=78, attempts=2, qualify="Yes")
)

# Add a column
exam_data$grade <- ifelse(exam_data$score >= 80, "A", "B")

print(exam_data)

# Sort by score
sorted_data <- exam_data[order(exam_data$score, decreasing=TRUE), ]

print(sorted_data)

# Save data
write.csv(exam_data, "exam_data.csv", row.names=FALSE)
