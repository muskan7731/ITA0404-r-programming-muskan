library(reshape2)

data(airquality)

print(head(airquality))

# Melt data
melted <- melt(
  airquality,
  id.vars = "Month",
  measure.vars = c("Ozone", "Solar.R", "Wind", "Temp")
)

print(head(melted))

# Cast data
casted <- dcast(
  melted,
  Month ~ variable,
  fun.aggregate = mean,
  na.rm = TRUE
)

print(casted)
