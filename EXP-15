data(iris)

# Dimensions
print(dim(iris))

# Summary
print(summary(iris))

# Standard deviation
print(sd(iris$Sepal.Length))

# Quantiles
print(quantile(iris$Sepal.Length))

# Group mean by Species
print(aggregate(
  Sepal.Length ~ Species,
  data = iris,
  FUN = mean
))

# Pivot table
print(table(iris$Species))

# Categorize Sepal Length
iris$SepalCategory <- cut(
  iris$Sepal.Length,
  breaks = c(0, 5, 6, 7, Inf),
  labels = c("Short", "Medium", "Long", "Very Long")
)

print(table(iris$SepalCategory))
